# common/env.example — copy to common/env and edit. common/env is gitignored.
#
#   cp common/env.example common/env && $EDITOR common/env
#
# Shell syntax (this file is sourced). No spaces around '='.

# ---- image (all demos) ----------------------------------------------------
# Base bootc image the demos build FROM.
BASE_IMAGE="quay.io/centos-bootc/centos-bootc:stream10"
# Name of the image you build in demo 01 and reuse everywhere.
IMAGE_NAME="bootc-demo"
# Target architecture: amd64 or arm64. Must match your EC2 instance arch.
AMI_ARCH="amd64"

# ---- registry (demos 05/06) ----------------------------------------------
# A registry the EC2 host can pull from. Examples:
#   quay.io/<youruser>       ghcr.io/<youruser>      <acct>.dkr.ecr.<region>.amazonaws.com
REGISTRY="quay.io/CHANGE_ME"
# Full image ref is built as: $REGISTRY/$IMAGE_NAME:<tag>

# ---- AWS (demos 05/06) ----------------------------------------------------
# Nothing here is secret — real credentials live in ~/.aws (AWS CLI config).
AWS_PROFILE="default"
AWS_REGION="us-east-1"
# Existing S3 bucket used by bootc-image-builder to stage the raw disk import.
S3_BUCKET="CHANGE_ME-bootc-staging"
# EC2 instance type to launch from the AMI (match AMI_ARCH!).
#   amd64: t3.small / m5.large     arm64: t4g.small / m6g.large
INSTANCE_TYPE="t3.small"
# Optional: existing EC2 key pair name + SSH key path for logging into the instance.
EC2_KEY_NAME="CHANGE_ME"
EC2_SSH_KEY="$HOME/.ssh/id_ed25519"
# Optional: security group + subnet. Leave blank to use the account default VPC.
EC2_SECURITY_GROUP=""
EC2_SUBNET_ID=""
